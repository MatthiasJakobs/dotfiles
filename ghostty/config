font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14
font-thicken = true
adjust-cell-height = 10%

# Solarized Light (official altercation/solarized palette)
background = #fdf6e3
foreground = #657b83
cursor-color = #657b83
cursor-text = #fdf6e3
selection-background = #eee8d5
selection-foreground = #586e75
palette = 0=#073642
palette = 1=#dc322f
palette = 2=#859900
palette = 3=#b58900
palette = 4=#268bd2
palette = 5=#d33682
palette = 6=#2aa198
palette = 7=#eee8d5
palette = 8=#002b36
palette = 9=#cb4b16
palette = 10=#586e75
palette = 11=#657b83
palette = 12=#839496
palette = 13=#6c71c4
palette = 14=#93a1a1
palette = 15=#fdf6e3

window-padding-x = 16
window-padding-y = 4,12
window-theme = light

# Minimum contrast
minimum-contrast = 2

# Hide the titlebar for a cleaner look
#macos-titlebar-style = hidden

# Small polish
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = clipboard
