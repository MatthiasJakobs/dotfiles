font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14
font-thicken = true
adjust-cell-height = 10%

# Github dark
background = #010409
foreground = #e6edf3
selection-background = #264f78
selection-foreground = #e6edf3
cursor-color = #e6edf3
cursor-text = #010409
palette = 0=#484f58
palette = 1=#ff7b72
palette = 2=#3fb950
palette = 3=#d29922
palette = 4=#58a6ff
palette = 5=#bc8cff
palette = 6=#39c5cf
palette = 7=#b1bac4
palette = 8=#6e7681
palette = 9=#ffa198
palette = 10=#56d364
palette = 11=#e3b341
palette = 12=#79c0ff
palette = 13=#d2a8ff
palette = 14=#56d4dd
palette = 15=#ffffff

window-padding-x = 16
window-padding-y = 4,12
window-theme = dark

# Minimum contrast
#minimum-contrast = 2

# Hide the titlebar for a cleaner look
#macos-titlebar-style = hidden

# Small polish
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = clipboard
